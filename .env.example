# Contraseña de acceso al panel de propuestas (/propuestas/panel)
# Si no se define, se usa "nevox" por defecto (solo para desarrollo).
PROPUESTAS_PASSWORD=nevox

# Contraseña de acceso a la vista de propuestas (la que se comparte al cliente).
# Se usa cuando la propuesta no tiene contraseña propia definida desde el panel.
# Si no se define y la propuesta no tiene contraseña, la vista queda abierta.
PROPUESTAS_VIEW_PASSWORD=

# Panel interno admin (VPS) donde se persisten propuestas, clientes y proyectos.
# Base URL del API público del admin. Ej: https://admin.nevox.pro/api/public
NEVOX_ADMIN_API_URL=
# Token/API key compartido que valida el panel admin (Authorization: Bearer ...).
NEVOX_ADMIN_API_KEY=
